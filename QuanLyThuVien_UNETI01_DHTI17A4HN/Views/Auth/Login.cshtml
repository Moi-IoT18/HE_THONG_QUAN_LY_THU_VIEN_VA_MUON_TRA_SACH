@{
    ViewData["Title"] = "Đăng nhập hệ thống";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản Lý Thư Viện UNETI</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light d-flex align-items-center justify-content-center" style="height: 100vh;">
    <div class="card shadow-sm" style="width: 400px;">
        <div class="card-body p-4">
            <h3 class="text-center mb-4 text-primary fw-bold">ĐĂNG NHẬP</h3>
            <div class="text-center text-muted mb-3 small">
                Họ tên: Nguyễn Thế Đông - MSV: 23103100187
            </div>
            
            <form asp-action="Login" method="post">
                <div asp-validation-summary="All" class="text-danger small mb-3"></div>
                
                <div class="mb-3">
                    <label class="form-label fw-semibold">Tên đăng nhập</label>
                    <input type="text" name="tenDangNhap" class="form-control" required placeholder="Nhập tên đăng nhập..." />
                </div>
                
                <div class="mb-3">
                    <label class="form-label fw-semibold">Mật khẩu</label>
                    <input type="password" name="matKhau" class="form-control" required placeholder="Nhập mật khẩu..." />
                </div>
                
                <button type="submit" class="btn btn-primary w-100 py-2 fw-bold">ĐĂNG NHẬP</button>
            </form>
        </div>
    </div>
</body>
</html>