@* Họ và tên: Phan Vũ Thanh Thư
   Mã sinh viên: 23103100316
   Nội dung thực hiện: Sửa 1 dòng chi tiết mượn (số lượng, tình trạng khi mượn, ghi chú). *@
@model ChiTietMuonFormViewModel
@{ ViewData["Title"] = "Sửa chi tiết mượn"; }
<h3 class="page-title">Sửa chi tiết – phiếu #@Model.MaPhieuMuon</h3>
<div class="card"><div class="card-body">
    <form asp-action="Edit" method="post">
        <div asp-validation-summary="All" class="alert alert-danger py-2"></div>
        <input type="hidden" asp-for="MaChiTiet" />
        <input type="hidden" asp-for="MaPhieuMuon" />
        <p>Sách: <strong>@Model.TenSach</strong> <span class="text-muted">(còn @Model.SoLuongCon cuốn trong kho)</span></p>
        <div class="row g-3">
            <div class="col-md-3"><label asp-for="SoLuong" class="form-label"></label><input asp-for="SoLuong" type="number" min="1" class="form-control" /><span asp-validation-for="SoLuong"></span></div>
            <div class="col-md-4"><label asp-for="TinhTrangMuon" class="form-label"></label><select asp-for="TinhTrangMuon" asp-items="UiHelper.DanhSachEnum<TinhTrangMuon>()" class="form-select"></select></div>
            <div class="col-md-5"><label asp-for="GhiChu" class="form-label"></label><input asp-for="GhiChu" class="form-control" /></div>
        </div>
        <div class="mt-3"><button class="btn btn-thuvien"><i class="bi bi-save me-1"></i>Lưu</button> <a asp-action="Index" asp-route-maPhieu="@Model.MaPhieuMuon" class="btn btn-outline-secondary">Quay lại</a></div>
    </form>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
