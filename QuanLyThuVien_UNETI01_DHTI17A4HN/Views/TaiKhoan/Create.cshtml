@model TaiKhoanCreateViewModel
@{
    ViewData["Title"] = "Tạo tài khoản";
}

<div class="container mt-4" style="max-width: 700px;">
    <h2>Tạo tài khoản</h2>
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="TenDangNhap" class="form-label"></label>
            <input asp-for="TenDangNhap" class="form-control" autocomplete="username" />
            <span asp-validation-for="TenDangNhap" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="MatKhau" class="form-label"></label>
            <input asp-for="MatKhau" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="MatKhau" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="HoTen" class="form-label"></label>
            <input asp-for="HoTen" class="form-control" />
            <span asp-validation-for="HoTen" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" type="email" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="VaiTro" class="form-label"></label>
            <select asp-for="VaiTro" asp-items="Html.GetEnumSelectList<VaiTro>()" class="form-select"></select>
            <span asp-validation-for="VaiTro" class="text-danger"></span>
        </div>
        <div class="mb-3 form-check">
            <input asp-for="TrangThai" class="form-check-input" />
            <label asp-for="TrangThai" class="form-check-label"></label>
        </div>

        <button type="submit" class="btn btn-primary">Tạo tài khoản</button>
        <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
