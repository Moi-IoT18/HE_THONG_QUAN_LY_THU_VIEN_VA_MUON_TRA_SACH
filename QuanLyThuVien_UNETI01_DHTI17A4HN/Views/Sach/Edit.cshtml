@model SachFormViewModel
@{ ViewData["Title"] = "Sửa thông tin sách"; }
<h3 class="page-title">Sửa thông tin sách</h3>
<div class="card"><div class="card-body">
    <form asp-action="Edit" method="post">
        <partial name="_Form" model="Model" />
        <div class="mt-4">
            <button type="submit" class="btn btn-thuvien"><i class="bi bi-save me-1"></i>Lưu</button>
            <a asp-action="QuanLy" class="btn btn-outline-secondary">Quay lại</a>
        </div>
    </form>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

