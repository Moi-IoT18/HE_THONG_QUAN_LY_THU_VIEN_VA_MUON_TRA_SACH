@* Họ và tên: Trần Gia Nghĩa
   Mã sinh viên: 23103100228
   Nội dung thực hiện: Các trường nhập liệu sách dùng chung cho thêm/sửa (Module 2). *@
@model SachViewModel
<div class="mb-3">
    <label asp-for="TenSach" class="form-label"></label>
    <input asp-for="TenSach" class="form-control" />
    <span asp-validation-for="TenSach" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="TacGia" class="form-label"></label>
    <input asp-for="TacGia" class="form-control" />
    <span asp-validation-for="TacGia" class="text-danger"></span>
</div>
<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="MaTheLoai" class="form-label"></label>
        <select asp-for="MaTheLoai" asp-items="ViewBag.TheLoais" class="form-select"><option value="">-- Chọn thể loại --</option></select>
        <span asp-validation-for="MaTheLoai" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="MaNhaXuatBan" class="form-label"></label>
        <select asp-for="MaNhaXuatBan" asp-items="ViewBag.NhaXuatBans" class="form-select"><option value="">-- Chọn nhà xuất bản --</option></select>
        <span asp-validation-for="MaNhaXuatBan" class="text-danger"></span>
    </div>
</div>
<div class="row">
    <div class="col-md-4 mb-3">
        <label asp-for="NamXuatBan" class="form-label"></label>
        <input asp-for="NamXuatBan" type="number" min="1900" max="@DateTime.Today.Year" class="form-control" />
        <span asp-validation-for="NamXuatBan" class="text-danger"></span>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="SoLuong" class="form-label"></label>
        <input asp-for="SoLuong" type="number" min="0" class="form-control" />
        <span asp-validation-for="SoLuong" class="text-danger"></span>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="SoLuongCon" class="form-label"></label>
        <input asp-for="SoLuongCon" type="number" min="0" class="form-control" />
        <span asp-validation-for="SoLuongCon" class="text-danger"></span>
    </div>
</div>
<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="DonGia" class="form-label"></label>
        <input asp-for="DonGia" type="number" min="0" step="1000" class="form-control" />
        <span asp-validation-for="DonGia" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="ViTriKeSach" class="form-label"></label>
        <input asp-for="ViTriKeSach" class="form-control" />
        <span asp-validation-for="ViTriKeSach" class="text-danger"></span>
    </div>
</div>
<div class="mb-3">
    <label asp-for="TrangThai" class="form-label"></label>
    <select asp-for="TrangThai" asp-items="Html.GetEnumSelectList<TrangThaiSach>()" class="form-select"></select>
    <span asp-validation-for="TrangThai" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="GhiChu" class="form-label"></label>
    <textarea asp-for="GhiChu" rows="3" class="form-control"></textarea>
    <span asp-validation-for="GhiChu" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="AnhBia" class="form-label"></label>
    <input asp-for="AnhBia" type="file" accept=".png,.jpg,.jpeg,.webp,image/png,image/jpeg,image/webp" class="form-control" />
    <span asp-validation-for="AnhBia" class="text-danger"></span>
    @if (!string.IsNullOrWhiteSpace(Model.DuongDanAnhBiaHienTai))
    {
        <div class="mt-2">
            <img src="@Model.DuongDanAnhBiaHienTai" alt="Bìa sách hiện tại" class="book-cover-thumbnail" />
            <div class="form-check mt-2">
                <input asp-for="XoaAnhBia" class="form-check-input" />
                <label asp-for="XoaAnhBia" class="form-check-label"></label>
            </div>
        </div>
    }
</div>
