@model NhaXuatBan
@{ ViewData["Title"] = "Thêm nhà xuất bản"; }
<h3 class="page-title">Thêm nhà xuất bản</h3>
<div class="card"><div class="card-body">
    <form asp-action="Create" method="post">
        <partial name="_Form" model="Model" />
        <div class="mt-4"><button type="submit" class="btn btn-thuvien"><i class="bi bi-save me-1"></i>Lưu</button> <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a></div>
    </form>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

