@model IEnumerable<QuanLyThuVien_UNETI01_DHTI17A4HN.Models.TheLoai>

@{
    ViewData["Title"] = "Quản lý Thể loại";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Quản Lý Thể Loại Sách</h2>
        <a asp-action="Create" class="btn btn-success">+ Thêm thể loại mới</a>
    </div>

    <div class="text-muted mb-3 small">
        Thực hiện bởi: Nguyễn Thế Đông - 23103100187
    </div>

    <table class="table table-bordered table-striped shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Mã TL</th>
                <th>Tên thể loại</th>
                <th>Mô tả</th>
                <th>Trạng thái</th>
                <th>Thứ tự</th>
                <th class="text-center">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model) {
                <tr>
                    <td>@item.MaTheLoai</td>
                    <td class="fw-bold">@item.TenTheLoai</td>
                    <td>@item.MoTa</td>
                    <td>
                        @if(item.TrangThai) {
                            <span class="badge bg-success">Hoạt động</span>
                        } else {
                            <span class="badge bg-secondary">Khóa</span>
                        }
                    </td>
                    <td>@item.ThuTuHienThi</td>
                    <td class="text-center">
                        <a asp-action="Edit" asp-route-id="@item.MaTheLoai" class="btn btn-warning btn-sm">Sửa</a>
                        <a asp-action="Delete" asp-route-id="@item.MaTheLoai" class="btn btn-danger btn-sm">Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>