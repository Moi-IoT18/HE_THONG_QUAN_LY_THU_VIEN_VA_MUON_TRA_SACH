@model IEnumerable<QuanLyThuVien_UNETI01_DHTI17A4HN.Models.TheLoai>
@{
    ViewData["Title"] = "Danh sách thể loại";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2>Quản lý thể loại</h2>
            <div class="text-muted small">Admin quản lý dữ liệu nền</div>
        </div>
        <a asp-action="Create" class="btn btn-primary">Thêm thể loại</a>
    </div>

    @if (TempData["ThanhCong"] is string success)
    {
        <div class="alert alert-success">@success</div>
    }
    @if (TempData["Loi"] is string error)
    {
        <div class="alert alert-danger">@error</div>
    }

    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>Mã</th>
                <th>Tên thể loại</th>
                <th>Mô tả</th>
                <th>Thứ tự</th>
                <th>Trạng thái</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.MaTheLoai</td>
                    <td>@item.TenTheLoai</td>
                    <td>@(string.IsNullOrWhiteSpace(item.MoTa) ? "—" : item.MoTa)</td>
                    <td>@item.ThuTuHienThi</td>
                    <td>
                        @if (item.TrangThai)
                        {
                            <span class="badge bg-success">Hoạt động</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Khóa</span>
                        }
                    </td>
                    <td class="text-nowrap">
                        <a asp-action="Details" asp-route-id="@item.MaTheLoai" class="btn btn-sm btn-outline-info">Chi tiết</a>
                        <a asp-action="Edit" asp-route-id="@item.MaTheLoai" class="btn btn-sm btn-outline-primary">Sửa</a>
                        <a asp-action="Delete" asp-route-id="@item.MaTheLoai" class="btn btn-sm btn-outline-danger">Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
