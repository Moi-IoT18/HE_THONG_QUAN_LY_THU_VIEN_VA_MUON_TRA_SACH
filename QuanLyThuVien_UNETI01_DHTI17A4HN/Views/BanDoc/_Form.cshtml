@* Họ và tên: Đặng Thị Phượng
   Mã sinh viên: 23103100182
   Nội dung thực hiện: Form thêm/sửa bạn đọc (ngày dùng type=date, giới tính dùng radio). *@
@model BanDocFormViewModel
@{ var laThem = Model.MaBanDoc == 0; }
<div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
<input type="hidden" asp-for="MaBanDoc" />
<h6 class="text-thuvien">Tài khoản đăng nhập</h6>
<div class="row g-3 mb-3">
    <div class="col-md-6">
        <label asp-for="TenDangNhap" class="form-label"></label>
        @if (laThem)
        {
            <input asp-for="TenDangNhap" class="form-control" />
            <span asp-validation-for="TenDangNhap"></span>
        }
        else
        {
            <input class="form-control" value="@Model.TenDangNhap" disabled />
        }
    </div>
    <div class="col-md-6">
        <label asp-for="MatKhau" class="form-label">@(laThem ? "Mật khẩu" : "Đặt lại mật khẩu (để trống nếu không đổi)")</label>
        <input asp-for="MatKhau" class="form-control" />
        <span asp-validation-for="MatKhau"></span>
    </div>
</div>
<h6 class="text-thuvien">Thông tin bạn đọc</h6>
<div class="row g-3">
    <div class="col-md-6"><label asp-for="HoTen" class="form-label"></label><input asp-for="HoTen" class="form-control" /><span asp-validation-for="HoTen"></span></div>
    <div class="col-md-3"><label asp-for="NgaySinh" class="form-label"></label><input asp-for="NgaySinh" type="date" class="form-control" /><span asp-validation-for="NgaySinh"></span></div>
    <div class="col-md-3">
        <label class="form-label d-block">Giới tính</label>
        @foreach (var gt in Enum.GetValues<GioiTinh>())
        {
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" asp-for="GioiTinh" value="@gt" id="gt_@gt" />
                <label class="form-check-label" for="gt_@gt">@gt.TenHienThi()</label>
            </div>
        }
    </div>
    <div class="col-md-4"><label asp-for="SoDienThoai" class="form-label"></label><input asp-for="SoDienThoai" class="form-control" /><span asp-validation-for="SoDienThoai"></span></div>
    <div class="col-md-4"><label asp-for="Email" class="form-label"></label><input asp-for="Email" type="email" class="form-control" /><span asp-validation-for="Email"></span></div>
    <div class="col-md-4"><label asp-for="DiaChi" class="form-label"></label><input asp-for="DiaChi" class="form-control" /><span asp-validation-for="DiaChi"></span></div>
    <div class="col-md-4"><label asp-for="NgayCapThe" class="form-label"></label><input asp-for="NgayCapThe" type="date" class="form-control" /><span asp-validation-for="NgayCapThe"></span></div>
    <div class="col-md-4"><label asp-for="HanThe" class="form-label"></label><input asp-for="HanThe" type="date" class="form-control" /><span asp-validation-for="HanThe"></span></div>
    <div class="col-md-4"><label asp-for="TrangThai" class="form-label"></label><select asp-for="TrangThai" asp-items="UiHelper.DanhSachEnum<TrangThaiBanDoc>()" class="form-select"></select></div>
    <div class="col-12"><label asp-for="GhiChu" class="form-label"></label><textarea asp-for="GhiChu" class="form-control" rows="2"></textarea><span asp-validation-for="GhiChu"></span></div>
</div>
