@* Họ và tên: Đặng Thị Phượng
   Mã sinh viên: 23103100182
   Nội dung thực hiện: Hồ sơ cá nhân của bạn đọc đang đăng nhập + đổi mật khẩu. *@
@model HoSoViewModel
@{ ViewData["Title"] = "Hồ sơ cá nhân"; var dmk = (DoiMatKhauViewModel)ViewBag.DoiMatKhau; }
<h3 class="page-title">Hồ sơ cá nhân</h3>
<div class="row g-3">
    <div class="col-lg-8">
        <div class="card"><div class="card-body">
            <form asp-action="HoSo" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
                <div class="row g-3">
                    <div class="col-md-6"><label asp-for="HoTen" class="form-label"></label><input asp-for="HoTen" class="form-control" /><span asp-validation-for="HoTen"></span></div>
                    <div class="col-md-3"><label asp-for="NgaySinh" class="form-label"></label><input asp-for="NgaySinh" type="date" class="form-control" /><span asp-validation-for="NgaySinh"></span></div>
                    <div class="col-md-3">
                        <label class="form-label d-block">Giới tính</label>
                        @foreach (var gt in Enum.GetValues<GioiTinh>())
                        {
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" asp-for="GioiTinh" value="@gt" id="gt_@gt" />
                                <label class="form-check-label" for="gt_@gt">@gt.TenHienThi()</label>
                            </div>
                        }
                    </div>
                    <div class="col-md-6"><label asp-for="SoDienThoai" class="form-label"></label><input asp-for="SoDienThoai" class="form-control" /><span asp-validation-for="SoDienThoai"></span></div>
                    <div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" type="email" class="form-control" /><span asp-validation-for="Email"></span></div>
                    <div class="col-12"><label asp-for="DiaChi" class="form-label"></label><input asp-for="DiaChi" class="form-control" /><span asp-validation-for="DiaChi"></span></div>
                </div>
                <button class="btn btn-thuvien mt-3"><i class="bi bi-save me-1"></i>Lưu hồ sơ</button>
            </form>
        </div></div>
    </div>
    <div class="col-lg-4">
        <div class="card mb-3"><div class="card-body">
            <h6 class="text-thuvien">Thẻ bạn đọc</h6>
            <dl class="row mb-0 small">
                <dt class="col-6">Mã bạn đọc</dt><dd class="col-6">@Model.MaBanDoc</dd>
                <dt class="col-6">Tài khoản</dt><dd class="col-6">@Model.TenDangNhap</dd>
                <dt class="col-6">Ngày cấp</dt><dd class="col-6">@UiHelper.Ngay(Model.NgayCapThe)</dd>
                <dt class="col-6">Hạn thẻ</dt><dd class="col-6 @(Model.HanThe < DateTime.Today ? "text-danger fw-bold" : "")">@UiHelper.Ngay(Model.HanThe)</dd>
                <dt class="col-6">Trạng thái</dt><dd class="col-6"><span class="badge @UiHelper.MauTrangThai(Model.TrangThai)">@Model.TrangThai.TenHienThi()</span></dd>
                <dt class="col-6">Đang giữ</dt><dd class="col-6">@Model.SoSachDangGiu / @QuyDinh.SoSachToiDa cuốn</dd>
            </dl>
            <div class="form-text">Hạn thẻ và trạng thái do thủ thư cập nhật.</div>
        </div></div>
        <div class="card"><div class="card-body">
            <h6 class="text-thuvien">Đổi mật khẩu</h6>
            <form asp-action="DoiMatKhau" method="post">
                <div class="mb-2"><label asp-for="@dmk.MatKhauCu" class="form-label small"></label><input asp-for="@dmk.MatKhauCu" name="MatKhauCu" class="form-control form-control-sm" /></div>
                <div class="mb-2"><label asp-for="@dmk.MatKhauMoi" class="form-label small"></label><input asp-for="@dmk.MatKhauMoi" name="MatKhauMoi" class="form-control form-control-sm" /></div>
                <div class="mb-2"><label asp-for="@dmk.XacNhan" class="form-label small"></label><input asp-for="@dmk.XacNhan" name="XacNhan" class="form-control form-control-sm" /></div>
                <button class="btn btn-sm btn-outline-primary">Đổi mật khẩu</button>
            </form>
        </div></div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
