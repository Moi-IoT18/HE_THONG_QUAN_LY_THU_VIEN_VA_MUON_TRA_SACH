@* Họ và tên: Đặng Thị Phượng
   Mã sinh viên: 23103100182
   Nội dung thực hiện: Khối thông tin phiếu mượn + bảng chi tiết sách (dùng chung cho bạn đọc và thủ thư). *@
@model PhieuMuon
@{
    var soNgayQuaHan = Model.TrangThai is TrangThaiPhieu.DangMuon or TrangThaiPhieu.QuaHan
        ? QuaHanService.TinhSoNgayQuaHan(Model.HanTra) : 0;
    var laPhieuDangMuon = Model.TrangThai is TrangThaiPhieu.DangMuon or TrangThaiPhieu.QuaHan;
    var tienPhatHienTai = laPhieuDangMuon
        ? Model.ChiTietMuons.Sum(ct => QuaHanService.TinhTienPhatTamTinh(Model.HanTra, ct.SoLuong))
        : Model.TienPhat;
}
<div class="card mb-3"><div class="card-body">
    <div class="d-flex justify-content-between align-items-start">
        <h4 class="text-thuvien mb-3">Phiếu mượn #@Model.MaPhieuMuon</h4>
        <span class="badge fs-6 @UiHelper.MauTrangThai(Model.TrangThai)">@Model.TrangThai.TenHienThi()</span>
    </div>
    <div class="row">
        <div class="col-md-6">
            <dl class="row mb-0">
                <dt class="col-5">Bạn đọc</dt><dd class="col-7">@(Model.BanDoc?.HoTen ?? Context.Session.LayHoTen())</dd>
                <dt class="col-5">Ngày tạo phiếu</dt><dd class="col-7">@UiHelper.NgayGio(Model.NgayMuon)</dd>
                <dt class="col-5">Hạn trả</dt>
                <dd class="col-7">
                    @UiHelper.Ngay(Model.HanTra)
                    @if (soNgayQuaHan > 0) { <span class="badge bg-danger ms-1">Quá hạn @soNgayQuaHan ngày</span> }
                </dd>
                <dt class="col-5">Ngày trả</dt><dd class="col-7">@UiHelper.NgayGio(Model.NgayTra)</dd>
            </dl>
        </div>
        <div class="col-md-6">
            <dl class="row mb-0">
                <dt class="col-5">Nhân viên xử lý</dt><dd class="col-7">@(Model.NhanVien?.HoTen ?? "—")</dd>
                <dt class="col-5">Thời điểm xử lý</dt><dd class="col-7">@UiHelper.NgayGio(Model.NgayXuLy)</dd>
                <dt class="col-5">@(laPhieuDangMuon ? "Phạt tạm tính" : "Tiền phạt")</dt><dd class="col-7 fw-bold @(tienPhatHienTai > 0 ? "text-danger" : "")">@UiHelper.Tien(tienPhatHienTai)</dd>
                <dt class="col-5">Ghi chú</dt><dd class="col-7">@(Model.GhiChu ?? "—")</dd>
            </dl>
        </div>
    </div>
</div></div>
@if (Model.TrangThai == TrangThaiPhieu.DaTra && Model.TienPhat > 0)
{
    <section class="card fine-payment-card mb-3" aria-labelledby="fine-payment-title">
        <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                <div>
                    <span class="fine-payment-eyebrow">THANH TOÁN TIỀN PHẠT</span>
                    <h5 id="fine-payment-title" class="mt-1 mb-2">
                        @(Model.DaNopTienPhat ? "Đã thanh toán" : "Cần nộp tại thư viện")
                    </h5>
                    <p class="fine-payment-copy mb-0">
                        @if (Model.DaNopTienPhat)
                        {
                            <span>Đã thu bằng @Model.HinhThucNopPhat?.TenHienThi() lúc @UiHelper.NgayGio(Model.NgayNopTienPhat).</span>
                            @if (Model.NhanVienThuTienPhat is not null)
                            {
                                <span> Nhân viên xác nhận: @Model.NhanVienThuTienPhat.HoTen.</span>
                            }
                        }
                        else
                        {
                            <span>Nộp tiền mặt tại quầy thư viện và đề nghị nhân viên thu ngân ghi nhận phiếu #@Model.MaPhieuMuon.</span>
                            <span> Muốn chuyển khoản, hãy liên hệ thủ thư để nhận thông tin tài khoản chính thức; chỉ chuyển đúng số tiền phạt và ghi nội dung “Phieu #@Model.MaPhieuMuon”. Nhân viên sẽ xác nhận sau khi đối soát giao dịch.</span>
                        }
                    </p>
                </div>
                <strong class="fine-payment-amount">@UiHelper.Tien(Model.TienPhat)</strong>
            </div>
        </div>
    </section>
}
<div class="card mb-3"><div class="card-body p-0">
<table class="table mb-0">
    <thead><tr><th>#</th><th>Bìa</th><th>Sách</th><th class="text-center">SL</th><th>Tình trạng mượn</th><th>Tình trạng trả</th><th class="text-center">Ngày quá hạn</th><th class="text-end">@(laPhieuDangMuon ? "Phạt tạm tính" : "Tiền phạt")</th></tr></thead>
    <tbody>
    @{ var stt = 0; }
    @foreach (var ct in Model.ChiTietMuons)
    {
        stt++;
        var soNgayQuaHanDong = laPhieuDangMuon ? soNgayQuaHan : ct.SoNgayQuaHan;
        var tienPhatDong = laPhieuDangMuon
            ? QuaHanService.TinhTienPhatTamTinh(Model.HanTra, ct.SoLuong)
            : ct.TienPhat;
        <tr>
            <td>@stt</td>
            <td class="book-cover-cell"><partial name="_BookCover" model="ct.Sach?.TenSach ?? string.Empty" view-data='new ViewDataDictionary(ViewData) { ["CoverClass"] = "book-cover-thumbnail", ["CoverUrl"] = ct.Sach?.DuongDanAnhBia }' /></td>
            <td><a asp-controller="Sach" asp-action="Details" asp-route-id="@ct.MaSach">@ct.Sach?.TenSach</a><div class="small text-muted">@ct.Sach?.TacGia</div></td>
            <td class="text-center">@ct.SoLuong</td>
            <td>@ct.TinhTrangMuon.TenHienThi()</td>
            <td>@if (ct.TinhTrangTra.HasValue) { <span class="badge @UiHelper.MauTinhTrangTra(ct.TinhTrangTra)">@ct.TinhTrangTra.Value.TenHienThi()</span> } else { <span class="text-muted">Chưa trả</span> }</td>
            <td class="text-center">@soNgayQuaHanDong</td>
            <td class="text-end">@UiHelper.Tien(tienPhatDong)</td>
        </tr>
    }
    </tbody>
    <tfoot><tr><th colspan="7" class="text-end">@(laPhieuDangMuon ? "Tổng phạt tạm tính" : "Tổng tiền phạt")</th><th class="text-end">@UiHelper.Tien(tienPhatHienTai)</th></tr></tfoot>
</table>
</div></div>
